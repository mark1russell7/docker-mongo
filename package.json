{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/docker-mongo",
  "version": "0.1.4",
  "description": "Reusable MongoDB Docker setup with TypeScript utilities for init and seed operations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/docker-mongo.git"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/docker-mongo/issues"
  },
  "homepage": "https://mark1russell7.github.io/docker-mongo/",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "import": "./dist/pure.js",
      "default": "./dist/pure.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "docker-compose.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && pnpm --filter @docker-mongo/site run typecheck",
    "test": "vitest run && pnpm --filter @docker-mongo/site run test",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "check:conventions": "conventions check",
    "check:api": "api-report check ."
  },
  "dependencies": {
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "@mark1russell7/api-report": "^0.5.3",
    "@mark1russell7/conventions": "^0.41.0",
    "@mark1russell7/cue": "^2.1.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mongodb",
    "docker",
    "docker-compose",
    "database",
    "seed",
    "init",
    "typescript"
  ],
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
