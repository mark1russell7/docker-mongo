{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/docker-mongo",
  "version": "0.1.0",
  "description": "Reusable MongoDB Docker setup with TypeScript utilities for init and seed operations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/docker-mongo.git"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/docker-mongo/issues"
  },
  "homepage": "https://github.com/mark1russell7/docker-mongo#readme",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docker-compose.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "dependencies": {
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0",
    "@mark1russell7/cue": "^1.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mongodb",
    "docker",
    "docker-compose",
    "database",
    "seed",
    "init",
    "typescript"
  ],
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
