    "@mark1russell7/site-pages": "^0.1.10"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.1.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
