{
  "$schema": "https://json.schemastore.org/package",
  "name": "@docker-mongo/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The GitHub Pages site of docker-mongo: edit the settings, and see the connection string, the Compose file and the plans of init and seed.",
